{
  "name": "walnut-academy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "lockfile:check": "node scripts/lockfile.mjs",
    "lockfile:fix": "node scripts/lockfile.mjs --fix",
    "colours:check": "node scripts/brand-colours.mjs",
    "test": "node scripts/lockfile.mjs && node scripts/brand-colours.mjs && turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
